 "phrases": [
  {
   "from": "상대 반응이 중요한 항목(갱 대상)은 이 티어 데이터를 우선 씁니다. 표본이 부족하면 마스터+ 데이터를 씁니다.",
   "to": "갱처럼 상대 반응에 따라 달라지는 건 이 티어 기록을 먼저 써요. 판 수가 부족하면 마스터+ 기록을 써요."
  },
  {
   "from": "적이 후반으로 갈수록 유리합니다. 초반 갱·오브젝트로 격차를 만들고 25분 전후에 끝내는 운영이 필요합니다.",
   "to": "상대가 후반 조합이에요. 초반 갱과 오브젝트로 차이를 벌리고 25분 전후에 끝내세요."
  },
  {
   "from": "상대 진영·강가에서의 데스는 진입 전 적 정글·라이너 위치(미니맵, 라인에 없는 적) 확인이 먼저입니다.",
   "to": "상대 정글이나 강가에서 죽었다면, 들어가기 전에 미니맵으로 상대 정글과 라인에 안 보이는 적부터 확인하세요."
  },
  {
   "from": "아군이 후반으로 갈수록 유리합니다. 초반 무리한 교전보다 시야·오브젝트 교환으로 성장 시간을 버세요.",
   "to": "우리 팀이 후반 조합이에요. 초반엔 무리하게 싸우지 말고 시야 잡고 오브젝트 맞교환하며 버티세요."
  },
  {
   "from": "반대편에 있었다면 그 시간에 내 쪽에서 이득(캠프·스커틀·반대 라인 갱)을 챙겼는지가 중요합니다.",
   "to": "반대편에 있었다면 그동안 내 쪽에서 캠프·바위게·반대쪽 갱으로 이득을 챙겼어야 해요."
  },
  {
   "from": "적 정글 갱을 막지 못한 순간 (10분 전, 아군 사망 + 적 정글 관여, 내가 멀리 있음)",
   "to": "상대 정글 갱에 아군이 죽은 순간 (10분 전, 나는 멀리 있었음)"
  },
  {
   "from": "이만큼 모였으면 싸우기 전에 귀환해서 아이템으로 바꾸는 턴을 먼저 잡았어야 합니다.",
   "to": "이만큼 모였으면 싸우기 전에 먼저 귀환해서 템부터 샀어야 해요."
  },
  {
   "from": "적 정글 위치가 예측하기 어려운 구간이었으니 진입 전 시야 확인이 필요했습니다.",
   "to": "상대 정글 위치를 알기 어려운 때였으니 들어가기 전에 시야부터 확인했어야 해요."
  },
  {
   "from": "쯤이라, 1분 전쯤 리셋하고 근처 라인 우선권을 챙겨 자리를 잡았어야 합니다.",
   "to": "쯤 나오니, 1분 전에 귀환하고 근처 라인 주도권을 잡은 뒤 자리 잡았어야 해요."
  },
  {
   "from": "까지 챔피언 기준 클리어 완료 (풀클 위주 챔피언 6캠프, 아니면 4캠프)",
   "to": "까지 목표 캠프 수 먹기 (풀캠 챔피언 6캠프, 아니면 4캠프)"
  },
  {
   "from": "스폰 90초 전 리셋, 60초 전 시야, 30초 전 자리와 주도권 확인.",
   "to": "나오기 90초 전 귀환, 60초 전 시야 작업, 30초 전 자리 선점과 라인 주도권 확인."
  },
  {
   "from": "대부분 3분 안에 6캠프를 다 돌고, 그 뒤 스커틀(2:55 생성)이나",
   "to": "대부분 3분 안에 풀캠을 하고, 그 뒤 바위게(2:55 등장)나"
